@using LMS.Shared.DTOs
@using LMS.Blazor.Client.Services
@using LMS.Shared.DTOs.ApplicationUserDTOs
@using LMS.Shared.DTOs.CourseDTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Route(VBRoutes.Student.LinkToAdministrationAccount)]
@rendermode InteractiveWebAssembly

<PageTitle>Account Administration</PageTitle>

<h3>Account Administration</h3>

<a href="/AddNewUser" class="btn btn-secondary pointer my-5">Add new user</a>

<div class="card p-3 shadow">
    <h2 class="text-center p-3">Manage Users</h2>
    <nav>
        <div class="nav nav-tabs mb-3" id="nav-tab" role="tablist">
            <button @onclick="@(e => SwitchTab(Student))" class="nav-link @(activeTab == Student ? "active" : "")" id="students-tab" data-bs-toggle="tab" data-bs-target="#nav-student" type="button" role="tab" aria-controls="nav-student" aria-selected="true">Students</button>
            <button @onclick="@(e => SwitchTab(Teacher))" class="nav-link @(activeTab == Teacher ? "active" : "")" id="teachers-tab" data-bs-toggle="tab" data-bs-target="#nav-teacher" type="button" role="tab" aria-controls="nav-teacher" aria-selected="false">Teachers</button>
        </div>
    </nav>

    <Search SearchString="@searchTerm" OnSearch="HandleSearch" />

        <div class="tab-content p-3 border bg-light">
            <div class="tab-pane @(activeTab == Student ? "active" : "")">
                <UserTable Items="searchResults" IsLoading ="isLoading"/>
            </div>
            <div class="tab-pane @(activeTab == Teacher ? "active" : "")">
                <UserTable Items="searchResults" IsLoading="isLoading" />
            </div>
        </div>
    
</div>

@code {
    [Inject]
    private IApiService _apiService { get; set; } = default!;
    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;

    private const string Student = "Student";
    private const string Teacher = "Teacher";

    private string searchTerm = string.Empty;
    private string activeTab = Student;
    private List<ApplicationUserDTO> data = new();
    private List<ApplicationUserDTO> searchResults = new();
    private bool isLoading = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoading = true;
            await LoadAndSetUsersAsync();
        }
    }

    private async Task<List<ApplicationUserDTO>> LoadUsersAsync(string roleFilter)
    {
        var response = await _apiService.GetAsync<ApplicationUserResultDTO>($"api/enrollment/user?roleFilter={roleFilter}");
        return response?.Result ?? new List<ApplicationUserDTO>();
    }

    private async Task LoadAndSetUsersAsync()
    {
        isLoading = true;
        StateHasChanged();

        data = await LoadUsersAsync(activeTab);
        searchResults = data;

        isLoading = false;
        StateHasChanged();
    }

    private async void SwitchTab(string tabName)
    {
        if (activeTab != tabName)
        {
            activeTab = tabName;
            await LoadAndSetUsersAsync();
        }
    }

    private void HandleSearch(string searchString)
    {
        searchTerm = searchString;

        if (string.IsNullOrWhiteSpace(searchString))
        {
            searchResults = data;
        }
        else
        {
            searchResults = data
                .Where(user => user.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
}
