@using LMS.Shared.DTOs
@attribute [Route(VBRoutes.Student.LinkToAdministrationAccount)]
@rendermode InteractiveWebAssembly

<PageTitle>Account Administration</PageTitle>

<h3>Account Administration</h3>

@* ToDo add the href to new user page *@
<button>Add new user</button>

<h5> Manage Users</h5>


	<div class="card p-3 shadow">
		<h2 class="text-center p-3">Manage Users</h2>
		<nav>
			<div class="nav nav-tabs mb-3" id="nav-tab" role="tablist">
				<button class="nav-link active" id="nav-home-tab" data-bs-toggle="tab" data-bs-target="#nav-home" type="button" role="tab" aria-controls="nav-home" aria-selected="true">Stusents</button>
				<button class="nav-link" id="nav-profile-tab" data-bs-toggle="tab" data-bs-target="#nav-profile" type="button" role="tab" aria-controls="nav-profile" aria-selected="false">Teachers</button>
				
			</div>
		</nav>

	<Search SearchString="@searchTerm" OnSearch="HandleSearch" />
		<div class="tab-content p-3 border bg-light" id="nav-tabContent">
		

			<div class="tab-pane fade active show" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab">
			<UserTable Items="searchResults" />
			</div>
			<div class="tab-pane fade" id="nav-profile" role="tabpanel" aria-labelledby="nav-profile-tab">
				<p><strong>This is some placeholder content the TEACHERS tab's associated content.</strong>
					Clicking another tab will toggle the visibility of this one for the next.
					The tab JavaScript swaps classes to control the content visibility and styling. You can use it with
					tabs, pills, and any other <code>.nav</code>-powered navigation.</p>
			</div>
			
		</div>
	</div>


@code {
	private string searchTerm = string.Empty;

	private List<UserDto> data = new List<UserDto>
	{
		new UserDto { Username = "Alice", UserId = 1, Course = "Math", Enrolled = new DateTime(2023, 9, 15) },
		new UserDto { Username = "Bob", UserId = 2, Course = "Science", Enrolled = new DateTime(2023, 9, 15) },
		new UserDto { Username = "Charlie", UserId = 3, Course = "History", Enrolled = new DateTime(2023, 9, 15) },
		new UserDto { Username = "Diana", UserId = 4, Course = "Art", Enrolled = new DateTime(2023, 9, 15) },
		new UserDto { Username = "Eve", UserId = 5, Course = "Music", Enrolled = new DateTime(2023, 9, 15) },
		new UserDto { Username = "Frank", UserId = 6, Course = "Physics", Enrolled = new DateTime(2023, 9, 15) },
		new UserDto { Username = "Grace", UserId = 7, Course = "Chemistry", Enrolled = new DateTime(2023, 9, 15) }
	};

	private List<UserDto> searchResults = new();

	private void HandleSearch(string searchString)
	{
		searchTerm = searchString;

		if (string.IsNullOrWhiteSpace(searchString))
		{
			searchResults = data;
		}
		else
		{
			searchResults = data
				.Where(user => user.Username.Contains(searchString, StringComparison.OrdinalIgnoreCase))
				.ToList();
		}

		Console.WriteLine($"Search Term: {searchString}");
		Console.WriteLine($"Search Results: {string.Join(", ", searchResults.Select(u => u.Username))}");
	}

	protected override void OnInitialized()
	{
		searchResults = data; 
	}

}

