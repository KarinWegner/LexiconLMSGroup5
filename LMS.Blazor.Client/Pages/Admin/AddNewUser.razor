@using LMS.Shared.DTOs
@using LMS.Blazor.Client.Services
@using System.ComponentModel.DataAnnotations

@attribute [Route(VBRoutes.Administration.LinkAddNewUser)]
@rendermode InteractiveWebAssembly

<PageTitle>User Registration</PageTitle>

<h3 class="text-center">Register New User</h3>
<div class="d-flex justify-content-center">
    <div class="card p-4 shadow" style="width:80%; max-width: 800px">
        <EditForm Model="@registrationModel" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="Name" class="form-label">Select User</label>
                <InputSelect id="Name" class="form-control" @bind-Value="registrationModel.UserName">
                    <option value="" disabled>Select a user</option>
                    @if (usersDetails != null)
                    {
                        @foreach (var user in usersDetails)
                        {
                            <option value="@user.UserName.ToString()">@user.UserName</option>
                        }
                    }
                </InputSelect>
               
                <ValidationMessage For="@(() => registrationModel.UserName)" />
            </div>

            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>
                <InputSelect id="Email" class="form-control" @bind-Value="registrationModel.Email">
                    <option value="" disabled>Select a email</option>
                    @if (usersDetails != null)
                    {
                        @foreach (var user in usersDetails)
                        {
                            <option value="@user.Email.ToString()">@user.Email</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="@(() => registrationModel.Email)" />
            </div>

            <div class="mb-3">
                <label for="Role" class="form-label">Role</label>
                <InputSelect id="Role" class="form-control" @bind-Value="registrationModel.Role">
                    <option value="" disabled>Select a role</option>
                    @if (roles != null)
                    {
                        @foreach (var role in roles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="@(() => registrationModel.Role)" />
            </div>

            <button type="submit" class="btn btn-primary">Add new user</button>
        </EditForm>
    </div>
</div>
@if (isSubmitting)
{
    <div class="d-flex justify-content-center my-3">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@if (submissionMessage != null)
{
    <div class="alert alert-info mt-3">@submissionMessage</div>
}

@code {
    [Inject]
    private IApiService _apiService { get; set; } = default!;

    private RegistrationModel registrationModel = new();
    private bool isSubmitting = false;
    private string? submissionMessage = null;
    private bool firstRender = true;

    private List<RoleDTO> roles = new();
    private List<UserDTO> usersDetails = new();

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        submissionMessage = null;
        // try
        // {
        //     // Example API endpoint for registration
        //     var response = await _apiService.PostAsync("api/auth/register", registrationModel);

        //     if (response.IsSuccessStatusCode)
        //     {
        //         submissionMessage = "Registration successful!";
        //         registrationModel = new(); // Reset the form
        //     }
        //     else
        //     {
        //         submissionMessage = "Registration failed. Please try again.";
        //     }
        // }
        // catch (Exception ex)
        // {
        //     submissionMessage = $"An error occurred: {ex.Message}";
        // }
        // finally
        // {
        //     isSubmitting = false;
        // }
    }

    private async Task LoadRolesAsync()
    {

        try
        {
            var response = await _apiService.GetAsync<List<RoleDTO>>("api/enrollment/roles");

            if (response != null)
            {
                roles = response;
            }
        }
        catch (Exception ex)
        {
            submissionMessage = $"Failed to load roles: {ex.Message}";
        }
    }

    private async Task LoadUsersDetailsAsync()
    {
        try
        {
            var response = await _apiService.GetAsync<List<UserDTO>>("api/enrollment/users/all");
            if (response != null)
            {
                usersDetails = response;
            }
        }
        catch (Exception ex)
        {
            submissionMessage = $"Failed to load users details: {ex.Message}";
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadRolesAsync();
            await LoadUsersDetailsAsync();

            StateHasChanged();

        }
    }


    private class RegistrationModel
    {
        [Required(ErrorMessage = "Name is required.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Role is required.")]
        public string Role { get; set; } = string.Empty;
    }
}
