@attribute [Route(VBRoutes.Administration.LinkToDashboard)]
@attribute [Authorize(Roles = "Teacher")]


@* Just a redirect page, here to make sure the active nav system plays nice mostly.*@


@code {
    [Inject]
    NavigationManager NavigationManager { get; set; }
    protected async override Task OnInitializedAsync()
    {
        NavigationManager.NavigateTo(VBRoutes.Administration.LinkToCourseDashboard);
        await base.OnInitializedAsync();
    }
}
