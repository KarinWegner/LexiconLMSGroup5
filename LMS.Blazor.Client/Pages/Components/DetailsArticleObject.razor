<article>
    <h4 class="ms-3 mt-3">@CourseEntry.Name</h4>
    @if(DisplayDate)
    {
        <DateWidget DisplayType="@(ShowDateOnly ? EDateDisplayType.DateInline : EDateDisplayType.DateTimeInline)" StartTime="CourseEntry.StartTime" EndTime="CourseEntry.EndTime"></DateWidget>
    }
    <div class="ms-4 me-4 mt-4">
        @CourseEntry.Description
    </div>

</article>