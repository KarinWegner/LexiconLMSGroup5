@page "/component-library"

<PageTitle>Component Library</PageTitle>

<div class="row flex">
    <div class="col-md-2">
        <button type="button" class="btn mb-2 mb-md-0 btn-primary btn-block">
            Primary
        </button>
    </div>

    <div class="col-md-2">
        <button type="button" class="btn mb-2 mb-md-0 btn-secondary btn-block">
            Secondary
        </button>
    </div>

    <div class="col-md-2">
        <button type="button" class="btn mb-2 mb-md-0 btn-info btn-block">
            Info
        </button>
    </div>

    <div class="col-md-2">
        <button type="button" class="btn mb-2 mb-md-0 btn-success btn-block">
            Success
        </button>
    </div>

    <div class="col-md-2">
        <button type="button" class="btn mb-2 mb-md-0 btn-danger btn-block">
            Danger
        </button>
    </div>
</div>

<div class="row flex">
    <div class="col-md-2">
        <button type="button" class="btn mb-2 mb-md-0 btn-primary=outline btn-block">
            Primary Outline
        </button>
    </div>

    <div class="col-md-2">
        <button type="button" class="btn mb-2 mb-md-0 btn-secondary-outline btn-block">
            Secondary Outline
        </button>
    </div>
</div>
<div class="row ">
    <p class="text-primary">Primary text.</p>
    <p class="text-success">Success text.</p>
    <p class="text-danger">Danger and warning text.</p>
    <p class="text-info">Info text.</p>

</div>

